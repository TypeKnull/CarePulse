# CarePulse Backend Environment Configuration
# Copy this file to .env and adjust credentials to match your local setup.

# Flask Application
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=carepulse_dev_flask_secret_change_in_production
JWT_SECRET=carepulse_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carepulse
DB_USER=root
DB_PASSWORD=
